---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const prompts = await getCollection('prompts');
---
<Layout title="Prompts / 提示词">
<div class="prompts-page">
<header class="page-heading">
  <h1>Prompts / <span lang="zh">提示词</span></h1>
  <p>A collection of useful AI prompts for various tasks. / <span lang="zh">实用AI提示词合集</span></p>
</header>
<div class="prompts-grid">
  {prompts.length > 0 ? prompts.map(prompt => (
    <a href={`/prompts/${prompt.slug}`} class="prompt-card surface-card">
      <h3 class="card-title-en">{prompt.data.title?.en}</h3>
      {prompt.data.title?.zh && <h4 class="card-title-zh">{prompt.data.title?.zh}</h4>}
      <p class="card-desc-en">{prompt.data.description?.en}</p>
      {prompt.data.description?.zh && <p class="card-desc-zh">{prompt.data.description?.zh}</p>}
      <span class="tag">{prompt.data.category}</span>
    </a>
  )) : (
    <p>Coming soon... 敬请期待...</p>
  )}
</div>
</div>
</Layout>

<style>
.prompts-page {
  padding-block: var(--space-page);
}
.prompts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  gap: 1.5rem;
}
.prompt-card {
  display: block;
  padding: 1.5rem;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}
.card-title-en {
  color: var(--text);
  margin-bottom: 0.25rem;
  font-size: 1.25rem;
  font-weight: 600;
}
.card-title-zh {
  color: var(--text-secondary);
  margin-bottom: 0.75rem;
  font-size: 1rem;
  font-weight: 500;
}
.card-desc-en {
  color: var(--text);
  margin-bottom: 0.25rem;
  font-size: 0.95rem;
  line-height: 1.5;
}
.card-desc-zh {
  color: var(--text-secondary);
  margin-bottom: 0.75rem;
  font-size: 0.9rem;
  line-height: 1.5;
}
.tag {
  margin-top: 0.75rem;
}
</style>
