---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { seriesNames } from '../config/series';

const posts = await getCollection('blog');
const orderedPosts = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredPost = orderedPosts[0];
const recentPosts = orderedPosts.slice(1, 10);

// Social covers repeat the title; keep actual diagrams and photographs as thumbnails.
function thumbnailFor(post: (typeof posts)[number]) {
  const image = post.data.image;
  if (!image || image === `/arxiv-visuals/${post.slug}.png` ||
      image === 'https://arxiv.org/static/browse/0.3.4/images/arxiv-logo-fb.png') return undefined;
  return image;
}

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});

const seriesMap = new Map<string, typeof posts>();
for (const post of posts) {
  if (post.data.series) {
    const arr = seriesMap.get(post.data.series) || [];
    arr.push(post);
    seriesMap.set(post.data.series, arr);
  }
}

const seriesData = Array.from(seriesMap.entries())
  .map(([key, seriesPosts]) => {
    const sorted = [...seriesPosts].sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));
    return {
      key,
      name: seriesNames[key] || { en: key, zh: key },
      count: seriesPosts.length,
      firstPost: sorted[0],
    };
  })
  .sort((a, b) => b.count - a.count);
---
<Layout title="Home / 首页">
  <section class="home-intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow" lang="zh">用行动赢得尊重</p>
      <h1 id="intro-title">Alan Hou</h1>
      <p class="intro-description">Notes on coding, AI, and technology.</p>
      <p class="intro-description-zh" lang="zh">记录编程、人工智能与技术探索。</p>
      <div class="intro-links">
        <a href="/blog">Explore the blog <span aria-hidden="true">→</span></a>
        <a href="/about">About me</a>
      </div>
    </div>

    {featuredPost && (
      <a href={`/blog/${featuredPost.slug}/`} class="featured-post surface-card">
        <div class="featured-copy">
          <p class="eyebrow">Latest article <span lang="zh">/ 最新文章</span></p>
          <h2>{featuredPost.data.title.en || featuredPost.data.title.zh}</h2>
          {featuredPost.data.title.en && featuredPost.data.title.zh && (
            <p class="post-title-zh" lang="zh">{featuredPost.data.title.zh}</p>
          )}
          {(featuredPost.data.description?.en || featuredPost.data.description?.zh) && (
            <p class="featured-description">{featuredPost.data.description?.en || featuredPost.data.description?.zh}</p>
          )}
          <div class="featured-meta">
            <time datetime={featuredPost.data.date.toISOString()}>{formatDate(featuredPost.data.date)}</time>
            <span class="read-article">Read article <span aria-hidden="true">→</span></span>
          </div>
        </div>
        {thumbnailFor(featuredPost) && (
          <img src={thumbnailFor(featuredPost)} alt="" class="post-image" />
        )}
      </a>
    )}
  </section>

  <section class="recent-posts" aria-labelledby="recent-title">
    <div class="section-heading">
      <h2 id="recent-title">Recent Posts <span lang="zh">/ 近期文章</span></h2>
      <a href="/blog" class="view-all">View all posts <span aria-hidden="true">→</span></a>
    </div>
    <div class="posts-grid">
      {recentPosts.map(post => (
        <a href={`/blog/${post.slug}/`} class="post-card surface-card">
          {thumbnailFor(post) && (
            <img src={thumbnailFor(post)} alt="" class="post-image" loading="lazy" />
          )}
          <div class="post-content">
            <div class="post-titles">
              <h3>{post.data.title.en || post.data.title.zh}</h3>
              {post.data.title.en && post.data.title.zh && (
                <p class="post-title-zh" lang="zh">{post.data.title.zh}</p>
              )}
            </div>
            <div class="post-meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="series-section" aria-labelledby="series-title">
    <div class="section-heading">
      <h2 id="series-title">Series <span lang="zh">/ 系列文章</span></h2>
    </div>
    <div class="series-grid">
      {seriesData.map(s => (
        <a href={`/blog/${s.firstPost.slug}/`} class="series-card surface-card">
          <h3>{s.name.en || s.name.zh}</h3>
          {s.name.en && s.name.zh && <p class="series-name-zh" lang="zh">{s.name.zh}</p>}
          <span class="series-count">{s.count} {s.count === 1 ? 'post' : 'posts'}</span>
        </a>
      ))}
    </div>
  </section>

  <nav class="quick-links" aria-label="More to explore">
    <a href="/prompts" class="quick-link surface-card">Prompts <span lang="zh">提示词</span><span aria-hidden="true">↗</span></a>
    <a href="/tools" class="quick-link surface-card">Tools <span lang="zh">工具</span><span aria-hidden="true">↗</span></a>
    <a href="/about" class="quick-link surface-card">About <span lang="zh">关于</span><span aria-hidden="true">↗</span></a>
  </nav>
</Layout>

<style>
.home-intro {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 5rem);
  padding: var(--space-page) 0;
  border-bottom: 1px solid var(--border);
}
.eyebrow {
  color: var(--primary);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  margin-bottom: 0.75rem;
}
.intro-copy h1 {
  font-size: clamp(2.25rem, 4vw, 3.25rem);
  letter-spacing: -0.04em;
  margin-bottom: 0.75rem;
}
.intro-description {
  max-width: 25ch;
  font-size: 1.35rem;
  line-height: 1.5;
  margin-bottom: 0.5rem;
}
.intro-description-zh {
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
}
.intro-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
  font-size: 0.95rem;
  font-weight: 600;
}
.intro-links a,
.view-all {
  text-decoration: none;
}
.intro-links a:hover,
.view-all:hover {
  text-decoration: underline;
  text-underline-offset: 0.2em;
}
.featured-post {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  text-decoration: none;
  color: var(--text);
}
.featured-copy {
  padding: clamp(1.25rem, 3vw, 2rem);
}
.featured-post h2 {
  font-size: clamp(1.25rem, 2vw, 1.5rem);
  line-height: 1.4;
  margin-bottom: 0.5rem;
}
.featured-description {
  color: var(--text-secondary);
  font-size: 0.95rem;
  margin: 1rem 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.featured-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 1.5rem;
  font-size: 0.85rem;
  color: var(--text-muted);
}
.read-article {
  color: var(--primary);
  font-weight: 600;
}
.recent-posts,
.series-section {
  padding-top: var(--space-page);
}
.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.section-heading h2 {
  font-size: 1.5rem;
  margin-bottom: 0;
}
.section-heading h2 span {
  color: var(--text-secondary);
  font-size: 0.85em;
  font-weight: 400;
}
.view-all {
  flex-shrink: 0;
  font-size: 0.9rem;
  font-weight: 600;
}
.posts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  gap: 1.25rem;
}
.post-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  text-decoration: none;
  color: var(--text);
}
.post-image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 0;
}
.post-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 1.5rem;
}
.post-titles {
  flex: 1;
}
.post-content h3 {
  font-size: 1.1rem;
  line-height: 1.5;
  margin-bottom: 0.5rem;
}
.post-title-zh {
  color: var(--text-secondary);
  font-size: 0.95rem;
  line-height: 1.65;
  margin-bottom: 0;
}
.post-meta {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}
.post-meta time {
  font-size: 0.8rem;
  color: var(--text-muted);
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.5rem;
}
.series-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  gap: 1.25rem;
}
.series-card {
  display: flex;
  flex-direction: column;
  padding: 1.5rem;
  text-decoration: none;
  color: var(--text);
}
.series-card h3 {
  font-size: 1rem;
  line-height: 1.5;
  margin-bottom: 0.25rem;
}
.series-name-zh {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin-bottom: 1rem;
}
.series-count {
  margin-top: auto;
  font-size: 0.8rem;
  color: var(--text-muted);
}
.quick-links {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.25rem;
  padding-top: var(--space-page);
}
.quick-link {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  padding: 1.25rem 1.5rem;
  text-decoration: none;
  color: var(--text);
  font-weight: 600;
}
.quick-link span[lang] {
  color: var(--text-secondary);
  font-size: 0.9rem;
  font-weight: 400;
}
.quick-link span:last-child {
  margin-left: auto;
  color: var(--primary);
}
@media (max-width: 768px) {
  .home-intro {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
  }
  .quick-links {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
}
</style>
