---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Icon Library" description="Professional SVG icon library with downloadable icons">
  <div class="icon-library">
    <header class="library-header page-heading">
      <h1>Icon Library / <span lang="zh">图标库</span></h1>
      <p class="subtitle">Professional SVG icons for your projects / <span lang="zh">可下载的 SVG 图标</span></p>
    </header>

    <div class="controls">
      <div class="search-box">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor">
          <circle cx="8" cy="8" r="6" stroke-width="2"/>
          <path d="M12.5 12.5L17 17" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input
          type="text"
          id="search-input"
          aria-label="Search icons"
          placeholder="Search icons..."
          autocomplete="off"
        />
      </div>

      <div class="filter-tabs">
        <button class="filter-tab active" data-category="all" aria-pressed="true">All Icons</button>
        <button class="filter-tab" data-category="language" aria-pressed="false">Language Study</button>
        <button class="filter-tab" data-category="bakery" aria-pressed="false">Bakery</button>
      </div>
    </div>

    <div class="stats" role="status" aria-live="polite">
      <span id="icon-count">0</span> icons
    </div>

    <div id="icon-grid" class="icon-grid">
      <!-- Icons will be dynamically loaded here -->
    </div>

    <div id="loading" class="loading">
      <div class="spinner"></div>
      <p>Loading icons...</p>
    </div>

    <div id="no-results" class="no-results" style="display: none;">
      <svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor">
        <circle cx="24" cy="24" r="20" stroke-width="3"/>
        <path d="M40 40L56 56" stroke-width="3" stroke-linecap="round"/>
        <path d="M18 24h12M24 18v12" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <p>No icons found</p>
      <small>Try a different search term</small>
    </div>
  </div>

  <!-- Download Modal -->
  <div id="download-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="modal-title">Download Icon</h2>
        <button class="close-btn" id="close-modal" aria-label="Close download dialog">&times;</button>
      </div>
      <div class="modal-body">
        <div class="icon-preview" id="icon-preview"></div>
        <div class="download-options">
          <button class="download-btn" id="download-svg">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 2v10m0 0l-3-3m3 3l3-3M4 14v2a2 2 0 002 2h8a2 2 0 002-2v-2"/>
            </svg>
            Download SVG
          </button>
          <button class="download-btn secondary" id="copy-svg">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z"/>
              <path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z"/>
            </svg>
            Copy SVG Code
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .icon-library {
    padding-block: var(--space-page);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .search-box {
    position: relative;
    flex: 1 1 280px;
    max-width: 480px;
  }
  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }
  #search-input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 3rem;
    font-size: 1rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    border-radius: var(--radius-control);
  }
  #search-input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }
  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .filter-tab {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    border-radius: var(--radius-control);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .filter-tab:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .filter-tab.active {
    background: var(--button-bg);
    color: var(--button-text);
    border-color: var(--button-bg);
  }
  .stats {
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }
  #icon-count {
    font-weight: 600;
    color: var(--text);
  }
  .icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: 1rem;
  }
  .icon-library :global(.icon-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .icon-library :global(.icon-artwork) {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
  }
  .icon-library :global(.icon-name) {
    font-size: 0.95rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .icon-library :global(.icon-category) {
    margin-top: auto;
    font-size: 0.75rem;
    text-transform: capitalize;
  }
  /* Recolor previews only; downloaded SVG source keeps its original palette. */
  .icon-library :global(.icon-artwork [fill="#111111"]),
  .icon-preview :global([fill="#111111"]) {
    fill: var(--text);
  }
  .icon-library :global(.icon-artwork [stroke="#111111"]),
  .icon-preview :global([stroke="#111111"]) {
    stroke: var(--text);
  }
  .icon-library :global(.icon-artwork [fill="#F5F2EA"]),
  .icon-preview :global([fill="#F5F2EA"]) {
    fill: var(--surface);
  }
  .loading, .no-results {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-secondary);
  }
  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 1rem;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .no-results svg {
    margin-bottom: 1rem;
    color: var(--text-muted);
  }
  .no-results p {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  .modal.active {
    display: flex;
  }
  .modal-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    max-width: 500px;
    width: 100%;
    max-height: 90vh;
    overflow: auto;
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .modal-header h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .close-btn {
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    color: var(--text-secondary);
    line-height: 1;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }
  .modal-body {
    padding: 1.5rem;
  }
  .icon-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    margin-bottom: 1.5rem;
  }
  .icon-preview :global(svg) {
    width: 180px;
    height: 180px;
  }
  .download-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .download-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .download-btn:not(.secondary) {
    background: var(--button-bg);
    color: var(--button-text);
  }
  .download-btn:not(.secondary):hover {
    background: var(--button-hover);
  }
  .download-btn.secondary {
    background: var(--surface);
    color: var(--primary);
    border-color: var(--border);
  }
  .download-btn.secondary:hover {
    background: var(--bg-secondary);
    border-color: var(--primary);
  }
  @media (max-width: 640px) {
    .search-box {
      max-width: none;
    }
    .filter-tab {
      padding: 0.65rem 0.85rem;
    }
    .icon-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 130px), 1fr));
    }
  }
</style>

<script>
  // Icon data will be loaded from SVG files
  let allIcons = [];
  let currentCategory = 'all';
  let searchTerm = '';
  let lastFocusedCard = null;

  // Parse SVG icon system
  async function loadIcons() {
    const iconSets = [
      { file: '/icons/mandarinai_language_study_icon_system.svg', category: 'language' },
      { file: '/icons/mandarinai_bakery_icon_system.svg', category: 'bakery' }
    ];

    for (const set of iconSets) {
      try {
        const response = await fetch(set.file);
        const svgText = await response.text();
        const parser = new DOMParser();
        const svgDoc = parser.parseFromString(svgText, 'image/svg+xml');

        // Extract individual icons
        const groups = svgDoc.querySelectorAll('svg > g[transform^="translate"]');
        groups.forEach((group, index) => {
          const textElement = group.querySelector('text');
          const name = textElement ? textElement.textContent.trim() : `Icon ${index + 1}`;

          // Clone the icon content (excluding the circle border and text)
          const iconGroup = group.querySelector('g[transform]');
          if (iconGroup) {
            const iconSvg = iconGroup.cloneNode(true);
            allIcons.push({
              name,
              category: set.category,
              svg: iconSvg.outerHTML,
              id: `${set.category}-${index}`
            });
          }
        });
      } catch (error) {
        console.error(`Error loading ${set.file}:`, error);
      }
    }

    renderIcons();
    document.getElementById('loading').style.display = 'none';
  }

  function renderIcons() {
    const grid = document.getElementById('icon-grid');
    const noResults = document.getElementById('no-results');

    // Filter icons
    let filtered = allIcons.filter(icon => {
      const matchesCategory = currentCategory === 'all' || icon.category === currentCategory;
      const matchesSearch = icon.name.toLowerCase().includes(searchTerm.toLowerCase());
      return matchesCategory && matchesSearch;
    });

    // Update count
    document.getElementById('icon-count').textContent = filtered.length;

    // Clear grid
    grid.innerHTML = '';

    if (filtered.length === 0) {
      grid.style.display = 'none';
      noResults.style.display = 'block';
      return;
    }

    grid.style.display = 'grid';
    noResults.style.display = 'none';

    // Render icons
    filtered.forEach(icon => {
      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'icon-card surface-card';
      card.setAttribute('aria-label', `Preview ${icon.name} icon`);
      card.innerHTML = `
        <svg class="icon-artwork" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
          ${icon.svg}
        </svg>
        <span class="icon-name">${icon.name}</span>
        <span class="icon-category tag">${icon.category}</span>
      `;
      card.addEventListener('click', () => {
        lastFocusedCard = card;
        openDownloadModal(icon);
      });
      grid.appendChild(card);
    });
  }

  function openDownloadModal(icon) {
    const modal = document.getElementById('download-modal');
    const preview = document.getElementById('icon-preview');
    const title = document.getElementById('modal-title');

    title.textContent = icon.name;
    preview.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
        ${icon.svg}
      </svg>
    `;

    modal.classList.add('active');
    document.getElementById('close-modal').focus();

    // Setup download handlers
    document.getElementById('download-svg').onclick = () => downloadIcon(icon);
    document.getElementById('copy-svg').onclick = () => copyIconSvg(icon);
  }

  function downloadIcon(icon) {
    const svgContent = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">${icon.svg}</svg>`;
    const blob = new Blob([svgContent], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${icon.name.toLowerCase().replace(/\s+/g, '-')}.svg`;
    a.click();
    URL.revokeObjectURL(url);
  }

  function copyIconSvg(icon) {
    const svgContent = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">${icon.svg}</svg>`;
    navigator.clipboard.writeText(svgContent).then(() => {
      const btn = document.getElementById('copy-svg');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg> Copied!';
      setTimeout(() => {
        btn.innerHTML = originalText;
      }, 2000);
    });
  }

  // Event listeners
  document.getElementById('search-input').addEventListener('input', (e) => {
    searchTerm = e.target.value;
    renderIcons();
  });

  document.querySelectorAll('.filter-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.filter-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-pressed', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-pressed', 'true');
      currentCategory = tab.dataset.category;
      renderIcons();
    });
  });

  function closeDownloadModal() {
    document.getElementById('download-modal').classList.remove('active');
    lastFocusedCard?.focus();
  }

  document.getElementById('close-modal').addEventListener('click', closeDownloadModal);

  document.getElementById('download-modal').addEventListener('click', (e) => {
    if (e.target.id === 'download-modal') {
      closeDownloadModal();
    }
  });

  document.getElementById('download-modal').addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeDownloadModal();
      return;
    }
    if (event.key !== 'Tab') return;
    const buttons = Array.from(document.querySelectorAll('#download-modal button'));
    const first = buttons[0];
    const last = buttons[buttons.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  // Load icons on page load
  loadIcons();
</script>
