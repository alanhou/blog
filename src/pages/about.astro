---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About / 关于">
  <section class="about-page">
    <header class="page-heading">
      <h1>About Alan Hou / <span lang="zh">关于</span></h1>
      <p lang="zh">用行动赢得尊重</p>
    </header>
    <p>A developer passionate about coding, AI, and technology.</p>
  </section>
</Layout>

<style>
.about-page {
  max-width: 72ch;
  margin-inline: auto;
  padding-block: var(--space-page);
}
.about-page > p {
  font-size: 1.1rem;
  line-height: 1.75;
}
</style>
