---
import Layout from '../../layouts/Layout.astro';
import { ELEMENTS, CATEGORIES } from '../../data/elements';

const lanthanides = ELEMENTS.filter(e => e.number >= 57 && e.number <= 71);
const actinides = ELEMENTS.filter(e => e.number >= 89 && e.number <= 103);

// Pre-compute 7 periods x 18 groups layout in frontmatter to keep JSX pristine
const gridRows = Array.from({ length: 7 }, (_, pIdx) => {
  const period = pIdx + 1;
  const cells = Array.from({ length: 18 }, (_, gIdx) => {
    const group = gIdx + 1;
    if (period === 6 && group === 3) {
      return { type: 'lanthanide-placeholder' };
    }
    if (period === 7 && group === 3) {
      return { type: 'actinide-placeholder' };
    }
    const elem = ELEMENTS.find(e => 
      e.period === period && 
      e.group === group && 
      !(e.number >= 57 && e.number <= 71) && 
      !(e.number >= 89 && e.number <= 103)
    );
    if (elem) {
      return { type: 'element', data: elem };
    }
    return { type: 'empty' };
  });
  return { period, cells };
});
---

<Layout 
  title="化学元素周期表 / Periodic Table of Elements"
  description="交互式化学元素周期表，支持拼音声调注音、标准普通话与英语语音朗读、全维度多模态搜索、手机端列表/表格双视图与详尽物理化学属性。"
  wide={true}
>
  <div class="periodic-page">
    <!-- Header -->
    <header class="page-header">
      <div class="header-content">
        <h1>
          <span class="zh-title">化学元素周期表</span>
          <span class="en-title">Periodic Table of Elements</span>
        </h1>
        <p class="header-desc">
          包含全部 118 种化学元素 · 支持<strong>拼音声调注音</strong> · <strong>标准发音朗读</strong> · <strong>手机移动端深度适配</strong> · 详尽物理化学性质
        </p>
      </div>

      <!-- Quick Stats & View Controls -->
      <div class="header-controls">
        <div class="view-toggles">
          <button id="view-grid-btn" class="view-btn active" title="标准周期表视图 / Standard Table View">
            <span class="btn-icon">⊞</span> 周期表视图
          </button>
          <button id="view-list-btn" class="view-btn" title="移动端检索列表视图 / Mobile List Card View">
            <span class="btn-icon">☰</span> 列表卡片视图
          </button>
        </div>

        <div class="display-toggles">
          <button id="toggle-pinyin-btn" class="toggle-btn active" title="切换拼音常显或隐藏">
            <span class="toggle-indicator">✓</span> 显示拼音与声调
          </button>
          <button id="toggle-weight-btn" class="toggle-btn active" title="切换原子量显示">
            <span class="toggle-indicator">✓</span> 显示原子量
          </button>
          <button id="toggle-fit-btn" class="toggle-btn" title="在「自适应屏幕（免横向滚动）」与「舒适大字模式」之间切换">
            <span class="toggle-indicator">↔</span> 展开大字模式
          </button>
        </div>
      </div>
    </header>

    <!-- Toolbar: Search & Filters -->
    <div class="toolbar">
      <!-- Search Input -->
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input 
          type="text" 
          id="element-search" 
          placeholder="搜索元素名称、拼音、符号或原子序号 (如: 铁 / tie / Fe / 26)..." 
          autocomplete="off"
          spellcheck="false"
        />
        <button id="search-clear-btn" class="clear-btn" title="清空搜索" hidden style="display: none;">&times;</button>
      </div>

      <!-- Filter Controls: Phase & Block -->
      <div class="filter-group">
        <div class="filter-item">
          <label for="phase-select">物态:</label>
          <select id="phase-select">
            <option value="all">全部物态 (All Phases)</option>
            <option value="solid">固态 (Solid)</option>
            <option value="liquid">液态 (Liquid)</option>
            <option value="gas">气态 (Gas)</option>
            <option value="synthetic">人工合成 (Synthetic)</option>
          </select>
        </div>

        <div class="filter-item">
          <label for="block-select">分区:</label>
          <select id="block-select">
            <option value="all">全部轨道 (All Blocks)</option>
            <option value="s">s 区 (碱金属/碱土)</option>
            <option value="p">p 区 (非金属/后过渡)</option>
            <option value="d">d 区 (过渡金属)</option>
            <option value="f">f 区 (镧系/锕系)</option>
          </select>
        </div>

        <button id="reset-filters-btn" class="reset-btn">重置筛选</button>
      </div>
    </div>

    <!-- Category Legend Pills -->
    <div class="category-legend">
      <div class="legend-title">元素族类分类 (点击高亮聚焦):</div>
      <div class="legend-list" id="category-pills">
        {Object.entries(CATEGORIES).map(([key, cat]) => (
          <button 
            class="category-pill" 
            data-category={key} 
            style={`--cat-color: ${cat.color}; --cat-border: ${cat.border};`}
          >
            <span class="color-dot"></span>
            <span class="cat-zh">{cat.zh}</span>
            <span class="cat-en">{cat.en}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Active Filter Status -->
    <div id="filter-status-bar" class="filter-status-bar" hidden style="display: none;">
      <span id="filter-status-text">正在筛选...</span>
      <button id="clear-status-btn" class="clear-status-btn">取消高亮</button>
    </div>

    <!-- View 1: Standard IUPAC Periodic Table Grid (Mobile Scrollable) -->
    <div id="grid-view-container" class="table-outer-wrapper">
      <div class="mobile-scroll-tip">
        <span>👉 左右滑动查看完整 18 族元素，点击任意元素查看物化参数与标准发音</span>
      </div>

      <div class="table-scroll-area">
        <div class="periodic-grid" id="main-periodic-grid">
          <!-- Column (Group) Headers 1 to 18 -->
          <div class="corner-header">周期 \ 族</div>
          {Array.from({ length: 18 }, (_, i) => (
            <div class="group-header" data-group={i + 1}>
              <span class="group-num">{i + 1}</span>
            </div>
          ))}

          <!-- Periods 1 to 7 -->
          {gridRows.map(row => (
            <Fragment>
              <!-- Sticky Period Header -->
              <div class="period-header" data-period={row.period}>
                <span class="period-num">{row.period}</span>
              </div>

              <!-- 18 Group Columns for this Period -->
              {row.cells.map(cell => {
                if (cell.type === 'lanthanide-placeholder') {
                  return (
                    <div class="element-cell placeholder-cell lanthanide-placeholder" data-special="lanthanide">
                      <span class="num">57-71</span>
                      <span class="sym">La-Lu</span>
                      <span class="name">镧系</span>
                      <span class="py">lán xì</span>
                    </div>
                  );
                }

                if (cell.type === 'actinide-placeholder') {
                  return (
                    <div class="element-cell placeholder-cell actinide-placeholder" data-special="actinide">
                      <span class="num">89-103</span>
                      <span class="sym">Ac-Lr</span>
                      <span class="name">锕系</span>
                      <span class="py">ā xì</span>
                    </div>
                  );
                }

                if (cell.type === 'empty' || !cell.data) {
                  return <div class="element-cell empty-cell" />;
                }

                const elem = cell.data;
                const cat = CATEGORIES[elem.category];
                return (
                  <button 
                    class={`element-cell cat-${elem.category} phase-${elem.phase}`} 
                    data-number={elem.number}
                    data-symbol={elem.symbol}
                    data-name={elem.name}
                    data-pinyin={elem.pinyin}
                    data-category={elem.category}
                    data-phase={elem.phase}
                    data-block={elem.block}
                    style={`--elem-color: ${cat?.color || '#94a3b8'}`}
                  >
                    <div class="cell-top">
                      <span class="elem-num">{elem.number}</span>
                      <span class="elem-weight">{elem.weight}</span>
                    </div>
                    <div class="cell-center">
                      <span class="elem-pinyin">{elem.pinyin}</span>
                      <div class="elem-symbol-row">
                        <span class="elem-symbol">{elem.symbol}</span>
                        <span class="elem-name">{elem.name}</span>
                      </div>
                    </div>
                    <div class="cell-bottom">
                      <span class="elem-en">{elem.english}</span>
                    </div>
                  </button>
                );
              })}
            </Fragment>
          ))}
        </div>

        <!-- Separate Lanthanide & Actinide Sub-Table (Directly Aligned with Groups 4-18) -->
        <div class="f-block-section">
          <!-- Lanthanide Row (57 to 71) -->
          <div class="f-series-row">
            <div class="f-series-label lanthanide-label">
              <span class="series-title">镧系 Lanthanides</span>
              <span class="sub-label">* 57 - 71</span>
            </div>
            {lanthanides.map(elem => {
              const cat = CATEGORIES[elem.category];
              return (
                <button 
                  class={`element-cell cat-${elem.category} phase-${elem.phase}`} 
                  data-number={elem.number}
                  data-symbol={elem.symbol}
                  data-name={elem.name}
                  data-pinyin={elem.pinyin}
                  data-category={elem.category}
                  data-phase={elem.phase}
                  data-block={elem.block}
                  style={`--elem-color: ${cat?.color || '#94a3b8'}`}
                >
                  <div class="cell-top">
                    <span class="elem-num">{elem.number}</span>
                    <span class="elem-weight">{elem.weight}</span>
                  </div>
                  <div class="cell-center">
                    <span class="elem-pinyin">{elem.pinyin}</span>
                    <div class="elem-symbol-row">
                      <span class="elem-symbol">{elem.symbol}</span>
                      <span class="elem-name">{elem.name}</span>
                    </div>
                  </div>
                  <div class="cell-bottom">
                    <span class="elem-en">{elem.english}</span>
                  </div>
                </button>
              );
            })}
          </div>

          <!-- Actinide Row (89 to 103) -->
          <div class="f-series-row">
            <div class="f-series-label actinide-label">
              <span class="series-title">锕系 Actinides</span>
              <span class="sub-label">** 89 - 103</span>
            </div>
            {actinides.map(elem => {
              const cat = CATEGORIES[elem.category];
              return (
                <button 
                  class={`element-cell cat-${elem.category} phase-${elem.phase}`} 
                  data-number={elem.number}
                  data-symbol={elem.symbol}
                  data-name={elem.name}
                  data-pinyin={elem.pinyin}
                  data-category={elem.category}
                  data-phase={elem.phase}
                  data-block={elem.block}
                  style={`--elem-color: ${cat?.color || '#94a3b8'}`}
                >
                  <div class="cell-top">
                    <span class="elem-num">{elem.number}</span>
                    <span class="elem-weight">{elem.weight}</span>
                  </div>
                  <div class="cell-center">
                    <span class="elem-pinyin">{elem.pinyin}</span>
                    <div class="elem-symbol-row">
                      <span class="elem-symbol">{elem.symbol}</span>
                      <span class="elem-name">{elem.name}</span>
                    </div>
                  </div>
                  <div class="cell-bottom">
                    <span class="elem-en">{elem.english}</span>
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- View 2: Responsive Card List View (Mobile-First / Search-Optimized) -->
    <div id="list-view-container" class="list-cards-container" hidden style="display: none;">
      <div class="list-stats">
        共找到 <span id="list-count">{ELEMENTS.length}</span> 个匹配元素
      </div>
      <div class="cards-grid" id="cards-grid">
        {ELEMENTS.map(elem => {
          const cat = CATEGORIES[elem.category];
          const phaseText = elem.phase === 'solid' ? '固态' : elem.phase === 'liquid' ? '液态' : elem.phase === 'gas' ? '气态' : '人造';
          return (
            <div 
              class="element-card" 
              data-number={elem.number}
              data-symbol={elem.symbol}
              data-name={elem.name}
              data-pinyin={elem.pinyin}
              data-pinyinpure={elem.pinyinPure}
              data-english={elem.english}
              data-category={elem.category}
              data-phase={elem.phase}
              data-block={elem.block}
              style={`--card-color: ${cat?.color || '#94a3b8'}`}
            >
              <div class="card-header">
                <span class="card-number">#{elem.number}</span>
                <span class="card-category-badge" style={`background-color: ${cat?.color}20; color: ${cat?.color}; border: 1px solid ${cat?.color}40;`}>
                  {cat?.zh}
                </span>
                <button class="card-speak-btn" data-name={elem.name} data-pinyin={elem.pinyin} data-english={elem.english} title="语音朗读">
                  🔊
                </button>
              </div>

              <div class="card-body">
                <div class="card-main-symbol">
                  <span class="card-pinyin">{elem.pinyin}</span>
                  <div class="card-char-group">
                    <span class="card-name">{elem.name}</span>
                    <span class="card-symbol">{elem.symbol}</span>
                  </div>
                  <span class="card-en">{elem.english}</span>
                </div>

                <div class="card-details">
                  <div class="card-prop">
                    <span class="prop-label">原子量:</span>
                    <span class="prop-val">{elem.weight}</span>
                  </div>
                  <div class="card-prop">
                    <span class="prop-label">形态:</span>
                    <span class="prop-val">{phaseText}</span>
                  </div>
                  <div class="card-prop">
                    <span class="prop-label">电子构型:</span>
                    <span class="prop-val mono">{elem.electronConfiguration}</span>
                  </div>
                </div>
              </div>

              <button class="card-view-btn" data-number={elem.number}>
                查看全量物化参数 &rarr;
              </button>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Empty Results Placeholder -->
    <div id="no-results" class="no-results" hidden style="display: none;">
      <div class="no-results-icon">⚛️</div>
      <h3>未匹配到符合条件的化学元素</h3>
      <p>请尝试搜索其他关键词（例如：铁、Fe、tie、26 或过渡金属）</p>
      <button id="reset-search-btn" class="reset-search-action">重置搜索条件</button>
    </div>

    <!-- Modal / Bottom Sheet for Element Details -->
    <div id="element-modal" class="modal-backdrop" hidden style="display: none;">
      <div class="modal-dialog" role="dialog" aria-modal="true">
        <!-- Close Button -->
        <button id="modal-close-btn" class="modal-close" aria-label="关闭">&times;</button>

        <div class="modal-content" id="modal-content-body">
          <!-- Dynamic Content Injected via Client Script -->
        </div>

        <!-- Modal Footer Navigation -->
        <div class="modal-footer">
          <button id="modal-prev-btn" class="modal-nav-btn">&larr; 上一个元素</button>
          <button id="modal-next-btn" class="modal-nav-btn">下一个元素 &rarr;</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ rawElements: ELEMENTS, rawCategories: CATEGORIES }}>
  // Initialize Client App State
  const elements = rawElements;
  const categories = rawCategories;
  const elementsMap = new Map(elements.map(e => [e.number, e]));

  let currentNumber = 1;
  let activeCategory = null;
  let activePhase = 'all';
  let activeBlock = 'all';
  let searchQuery = '';
  let showPinyin = true;
  let showWeight = true;
  let currentView = 'grid'; // 'grid' | 'list'

  // DOM Elements
  const searchInput = document.getElementById('element-search');
  const searchClearBtn = document.getElementById('search-clear-btn');
  const phaseSelect = document.getElementById('phase-select');
  const blockSelect = document.getElementById('block-select');
  const resetFiltersBtn = document.getElementById('reset-filters-btn');
  const categoryPills = document.querySelectorAll('.category-pill');
  const filterStatusBar = document.getElementById('filter-status-bar');
  const filterStatusText = document.getElementById('filter-status-text');
  const clearStatusBtn = document.getElementById('clear-status-btn');
  const viewGridBtn = document.getElementById('view-grid-btn');
  const viewListBtn = document.getElementById('view-list-btn');
  const gridContainer = document.getElementById('grid-view-container');
  const listContainer = document.getElementById('list-view-container');
  const listCount = document.getElementById('list-count');
  const noResults = document.getElementById('no-results');
  const togglePinyinBtn = document.getElementById('toggle-pinyin-btn');
  const toggleWeightBtn = document.getElementById('toggle-weight-btn');
  const toggleFitBtn = document.getElementById('toggle-fit-btn');
  const modal = document.getElementById('element-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalBody = document.getElementById('modal-content-body');
  const modalPrevBtn = document.getElementById('modal-prev-btn');
  const modalNextBtn = document.getElementById('modal-next-btn');
  const allGridCells = document.querySelectorAll('.table-scroll-area .element-cell:not(.empty-cell):not(.placeholder-cell)');
  const allCards = document.querySelectorAll('.element-card');

  // Text-To-Speech Pronunciation
  function speakElement(zhName, pinyin, enName) {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();

    // First speak Chinese name with pinyin
    const utterZh = new SpeechSynthesisUtterance(zhName);
    utterZh.lang = 'zh-CN';
    utterZh.rate = 0.9;

    // Then speak English
    const utterEn = new SpeechSynthesisUtterance(enName);
    utterEn.lang = 'en-US';
    utterEn.rate = 1.0;

    window.speechSynthesis.speak(utterZh);
    setTimeout(() => {
      window.speechSynthesis.speak(utterEn);
    }, 450);
  }

  // Apply All Active Filters & Search
  function applyFilters() {
    const query = searchQuery.trim().toLowerCase();
    let matchCount = 0;

    // Check each element
    elements.forEach(elem => {
      let matchesSearch = true;
      if (query) {
        const numStr = elem.number.toString();
        const sym = elem.symbol.toLowerCase();
        const name = elem.name.toLowerCase();
        const py = elem.pinyin.toLowerCase();
        const pyPure = elem.pinyinPure.toLowerCase();
        const en = elem.english.toLowerCase();
        matchesSearch = numStr === query ||
                        sym.includes(query) ||
                        name.includes(query) ||
                        py.includes(query) ||
                        pyPure.includes(query) ||
                        en.includes(query);
      }

      let matchesCat = true;
      if (activeCategory) {
        matchesCat = elem.category === activeCategory;
      }

      let matchesPhase = true;
      if (activePhase !== 'all') {
        matchesPhase = elem.phase === activePhase;
      }

      let matchesBlock = true;
      if (activeBlock !== 'all') {
        matchesBlock = elem.block === activeBlock;
      }

      const isMatch = matchesSearch && matchesCat && matchesPhase && matchesBlock;
      if (isMatch) matchCount++;

      // Update in Grid View
      const cell = document.querySelector(`.element-cell[data-number="${elem.number}"]`);
      if (cell) {
        if (isMatch) {
          cell.classList.remove('dimmed');
          cell.classList.add('highlighted');
        } else {
          cell.classList.remove('highlighted');
          cell.classList.add('dimmed');
        }
      }

      // Update in Card List View
      const card = document.querySelector(`.element-card[data-number="${elem.number}"]`);
      if (card) {
        card.style.display = isMatch ? 'flex' : 'none';
      }
    });

    // Update list count & empty state
    if (listCount) listCount.textContent = matchCount.toString();
    if (noResults) {
      noResults.hidden = matchCount > 0;
      noResults.style.display = matchCount > 0 ? 'none' : 'block';
    }

    // Update Status Bar
    if (activeCategory || activePhase !== 'all' || activeBlock !== 'all' || query) {
      filterStatusBar.hidden = false;
      filterStatusBar.style.display = 'flex';
      const parts = [];
      if (query) parts.push(`搜索: "${query}"`);
      if (activeCategory) parts.push(`族类: ${categories[activeCategory]?.zh}`);
      if (activePhase !== 'all') parts.push(`物态: ${phaseSelect.options[phaseSelect.selectedIndex].text}`);
      if (activeBlock !== 'all') parts.push(`分区: ${blockSelect.options[blockSelect.selectedIndex].text}`);
      filterStatusText.textContent = `当前筛选 [${parts.join(' · ')}] — 匹配到 ${matchCount} 个元素`;
    } else {
      filterStatusBar.hidden = true;
      filterStatusBar.style.display = 'none';
      allGridCells.forEach(cell => {
        cell.classList.remove('dimmed', 'highlighted');
      });
    }
  }

  // Open Element Detail Modal
  function openElementModal(num) {
    const elem = elementsMap.get(Number(num));
    if (!elem) return;
    currentNumber = elem.number;
    const cat = categories[elem.category] || { zh: '未知', en: 'Unknown', color: '#64748b' };
    const phaseText = elem.phase === 'solid' ? '固态 Solid' : elem.phase === 'liquid' ? '液态 Liquid' : elem.phase === 'gas' ? '气态 Gas' : '人工合成 Synthetic';

    modalBody.innerHTML = `
      <div class="modal-hero" style="--hero-cat-color: ${cat.color};">
        <div class="hero-left">
          <div class="hero-num-tag">原子序号 #${elem.number}</div>
          <div class="hero-char-wrap">
            <span class="hero-pinyin">${elem.pinyin}</span>
            <span class="hero-char">${elem.name}</span>
          </div>
          <div class="hero-symbol-row">
            <span class="hero-symbol">${elem.symbol}</span>
            <button class="hero-speak-btn" id="modal-speak-btn" title="朗读发音">
              🔊 听发音
            </button>
          </div>
          <div class="hero-english">${elem.english}</div>
        </div>

        <div class="hero-right">
          <div class="hero-badge-group">
            <span class="hero-badge cat-badge" style="background-color: ${cat.color}25; color: ${cat.color}; border: 1px solid ${cat.color}60;">
              ${cat.zh} (${cat.en})
            </span>
            <span class="hero-badge phase-badge">
              形态: ${phaseText}
            </span>
            <span class="hero-badge block-badge">
              分区: ${elem.block} 区 (${elem.period} 周期 / ${elem.group ? elem.group + ' 族' : '镧/锕系'})
            </span>
          </div>
          <p class="hero-summary">${elem.summary.zh}</p>
          <p class="hero-summary-en">${elem.summary.en}</p>
        </div>
      </div>

      <!-- Electron Shell Bohr Display -->
      <div class="modal-section electron-section">
        <h4 class="section-title">核外电子排布 & 能级层分布</h4>
        <div class="electron-row">
          <div class="electron-config-box">
            <span class="ec-label">电子构型:</span>
            <span class="ec-val mono">${elem.electronConfiguration}</span>
          </div>
          <div class="electron-shells-box">
            <span class="shells-label">各能级层电子数 (K L M N O P Q):</span>
            <div class="shell-chips">
              ${elem.electronsPerShell.map((count, idx) => `
                <div class="shell-chip">
                  <span class="shell-name">${['K','L','M','N','O','P','Q'][idx]}层</span>
                  <span class="shell-count">${count}</span>
                </div>
              `).join('')}
            </div>
          </div>
        </div>
      </div>

      <!-- Comprehensive Properties Grid -->
      <div class="modal-section">
        <h4 class="section-title">核心物理与化学参数</h4>
        <div class="props-table">
          <div class="prop-cell">
            <span class="cell-k">相对原子质量 (Atomic Weight)</span>
            <span class="cell-v">${elem.weight}</span>
          </div>
          <div class="prop-cell">
            <span class="cell-k">密度 (Density)</span>
            <span class="cell-v">${elem.density}</span>
          </div>
          <div class="prop-cell">
            <span class="cell-k">熔点 (Melting Point)</span>
            <span class="cell-v">${elem.melt}</span>
          </div>
          <div class="prop-cell">
            <span class="cell-k">沸点 (Boiling Point)</span>
            <span class="cell-v">${elem.boil}</span>
          </div>
          <div class="prop-cell">
            <span class="cell-k">电负性 (Electronegativity - Pauling)</span>
            <span class="cell-v">${elem.electronegativity}</span>
          </div>
          <div class="prop-cell">
            <span class="cell-k">发现时间与发现人</span>
            <span class="cell-v">${elem.discoveryYear} 年 · ${elem.discoveredBy}</span>
          </div>
        </div>
      </div>
    `;

    // Attach speech listener inside modal
    const speakBtn = document.getElementById('modal-speak-btn');
    if (speakBtn) {
      speakBtn.addEventListener('click', () => {
        speakElement(elem.name, elem.pinyin, elem.english);
      });
    }

    // Update Nav Buttons
    const prevElem = elementsMap.get(elem.number - 1);
    const nextElem = elementsMap.get(elem.number + 1);

    modalPrevBtn.disabled = !prevElem;
    modalPrevBtn.textContent = prevElem ? `← #${prevElem.number} ${prevElem.name} (${prevElem.symbol})` : '已是首位元素';

    modalNextBtn.disabled = !nextElem;
    modalNextBtn.textContent = nextElem ? `#${nextElem.number} ${nextElem.name} (${nextElem.symbol}) →` : '已是末位元素';

    modal.hidden = false;
    modal.classList.add('open');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.hidden = true;
    modal.classList.remove('open');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  // Event Listeners Setup
  function initPeriodicTable() {
    // Search Input
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      const hasQuery = Boolean(searchQuery);
      searchClearBtn.hidden = !hasQuery;
      searchClearBtn.style.display = hasQuery ? 'block' : 'none';
      applyFilters();
    });

    searchClearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      searchClearBtn.hidden = true;
      searchClearBtn.style.display = 'none';
      searchInput.focus();
      applyFilters();
    });

    // Phase Select
    phaseSelect.addEventListener('change', (e) => {
      activePhase = e.target.value;
      applyFilters();
    });

    // Block Select
    blockSelect.addEventListener('change', (e) => {
      activeBlock = e.target.value;
      applyFilters();
    });

    // Category Legend Click
    categoryPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-category');
        if (activeCategory === cat) {
          activeCategory = null;
          pill.classList.remove('active');
        } else {
          categoryPills.forEach(p => p.classList.remove('active'));
          activeCategory = cat;
          pill.classList.add('active');
        }
        applyFilters();
      });
    });

    // Clear Status / Reset
    const resetAll = () => {
      searchQuery = '';
      searchInput.value = '';
      searchClearBtn.hidden = true;
      searchClearBtn.style.display = 'none';
      activeCategory = null;
      activePhase = 'all';
      activeBlock = 'all';
      phaseSelect.value = 'all';
      blockSelect.value = 'all';
      categoryPills.forEach(p => p.classList.remove('active'));
      applyFilters();
    };

    resetFiltersBtn.addEventListener('click', resetAll);
    clearStatusBtn.addEventListener('click', resetAll);
    const resetSearchBtn = document.getElementById('reset-search-btn');
    if (resetSearchBtn) resetSearchBtn.addEventListener('click', resetAll);

    // View Switching
    viewGridBtn.addEventListener('click', () => {
      currentView = 'grid';
      viewGridBtn.classList.add('active');
      viewListBtn.classList.remove('active');
      gridContainer.hidden = false;
      gridContainer.style.display = 'block';
      listContainer.hidden = true;
      listContainer.style.display = 'none';
    });

    viewListBtn.addEventListener('click', () => {
      currentView = 'list';
      viewListBtn.classList.add('active');
      viewGridBtn.classList.remove('active');
      gridContainer.hidden = true;
      gridContainer.style.display = 'none';
      listContainer.hidden = false;
      listContainer.style.display = 'block';
      applyFilters();
    });

    // Pinyin & Weight Display Toggles
    togglePinyinBtn.addEventListener('click', () => {
      showPinyin = !showPinyin;
      togglePinyinBtn.classList.toggle('active', showPinyin);
      togglePinyinBtn.querySelector('.toggle-indicator').textContent = showPinyin ? '✓' : '✗';
      document.body.classList.toggle('hide-pinyin', !showPinyin);
    });

    toggleWeightBtn.addEventListener('click', () => {
      showWeight = !showWeight;
      toggleWeightBtn.classList.toggle('active', showWeight);
      toggleWeightBtn.querySelector('.toggle-indicator').textContent = showWeight ? '✓' : '✗';
      document.body.classList.toggle('hide-weight', !showWeight);
    });

    // Expand / Fit Screen Toggle
    let isTableExpanded = false;
    if (toggleFitBtn && gridContainer) {
      toggleFitBtn.addEventListener('click', () => {
        isTableExpanded = !isTableExpanded;
        gridContainer.classList.toggle('table-expanded', isTableExpanded);
        toggleFitBtn.classList.toggle('active', isTableExpanded);
        const indicator = toggleFitBtn.querySelector('.toggle-indicator');
        if (indicator) indicator.textContent = isTableExpanded ? '✓' : '↔';
        toggleFitBtn.title = isTableExpanded ? '点击恢复自适应屏幕模式' : '在「自适应屏幕（免横向滚动）」与「舒适大字模式」之间切换';
      });
    }

    // Element Cell Clicks in Grid
    allGridCells.forEach(cell => {
      cell.addEventListener('click', () => {
        const num = cell.getAttribute('data-number');
        if (num) openElementModal(Number(num));
      });
    });

    // Card Clicks in List View
    allCards.forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.card-speak-btn')) return;
        const num = card.getAttribute('data-number');
        if (num) openElementModal(Number(num));
      });
    });

    // Direct Speech on Card
    document.querySelectorAll('.card-speak-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const zh = btn.getAttribute('data-name');
        const py = btn.getAttribute('data-pinyin');
        const en = btn.getAttribute('data-english');
        speakElement(zh, py, en);
      });
    });

    // Modal Navigations
    modalPrevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentNumber > 1) openElementModal(currentNumber - 1);
    });

    modalNextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentNumber < 118) openElementModal(currentNumber + 1);
    });

    modalCloseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeModal();
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) {
        closeModal();
      } else if (!modal.hidden) {
        if (e.key === 'ArrowLeft' && currentNumber > 1) {
          openElementModal(currentNumber - 1);
        } else if (e.key === 'ArrowRight' && currentNumber < 118) {
          openElementModal(currentNumber + 1);
        }
      }
    });
  }

  // Safe Initialization whether DOMContentLoaded has fired or not
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPeriodicTable);
  } else {
    initPeriodicTable();
  }
</script>

