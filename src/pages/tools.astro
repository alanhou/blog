---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const tools = await getCollection('tools');

const builtInTools = [
  {
    title: { en: 'Password Generator', zh: '密码生成器' },
    description: { en: 'Generate secure random passwords with customizable options', zh: '生成安全随机密码，支持自定义选项' },
    url: '/tools/password-generator',
    icon: 'M8 10V7a4 4 0 0 1 8 0v3 M6 10h12v11H6z M12 14v3'
  },
  {
    title: { en: 'Base64 Image Encoder/Decoder', zh: 'Base64图片编解码' },
    description: { en: 'Convert images to/from Base64 format', zh: '图片与Base64格式互转' },
    url: '/tools/base64-image',
    icon: 'M3 3h18v18H3z M3 16l5-5 5 5 3-3 5 5 M16 7h.01'
  },
  {
    title: { en: 'QR Code Generator', zh: '二维码生成器' },
    description: { en: 'Generate QR codes from URLs or text with custom colors', zh: '从URL或文本生成二维码，支持自定义颜色' },
    url: '/tools/qrcode-generator',
    icon: 'M3 3h6v6H3z M15 3h6v6h-6z M3 15h6v6H3z M15 15h2v2h4v4h-6z M21 13v2'
  },
  {
    title: { en: 'JSON Parser & Viewer', zh: 'JSON解析查看器' },
    description: { en: 'Parse, format, and view JSON data with syntax highlighting', zh: '解析、格式化和查看JSON数据，支持语法高亮' },
    url: '/tools/json-viewer',
    icon: 'M8 4H5v6l-2 2 2 2v6h3 M16 4h3v6l2 2-2 2v6h-3 M10 12h4'
  },
  {
    title: { en: 'Unix Time Converter', zh: 'Unix时间戳转换' },
    description: { en: 'Convert between Unix timestamps and dates, supports seconds and milliseconds', zh: 'Unix时间戳与日期互转，支持秒和毫秒' },
    url: '/tools/unix-time',
    icon: 'M12 8v4l3 2 M9 2h6 M12 2v3 M19 5l2 2 M21 13a9 9 0 1 1-18 0 9 9 0 0 1 18 0'
  },
  {
    title: { en: 'Gemini Watermark Remover', zh: 'Gemini水印移除' },
    description: { en: 'Remove Gemini\'s visible watermark from AI-generated images', zh: '移除Gemini AI生成图片的可见水印' },
    url: '/tools/gemini-watermark',
    icon: 'M12 3l2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5z'
  },
  {
    title: { en: '即梦AI Watermark Remover', zh: '即梦AI水印移除' },
    description: { en: 'Remove 即梦AI\'s visible watermark from AI-generated images', zh: '移除即梦AI生成图片的可见水印' },
    url: '/tools/jimeng-watermark',
    icon: 'M4 20l4-1 12-12a2.1 2.1 0 0 0-3-3L5 16z M14 7l3 3 M4 20h16'
  },
  {
    title: { en: 'IP Lookup', zh: 'IP地址查询' },
    description: { en: 'Look up geolocation and details for any IP address', zh: '查询任意IP地址的地理位置和详细信息' },
    url: '/tools/ip-lookup',
    icon: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0 M3 12h18 M12 3c4 5 4 13 0 18-4-5-4-13 0-18'
  },
  {
    title: { en: 'Regex Tester', zh: '正则表达式测试器' },
    description: { en: 'Test regular expressions with common patterns and real-time highlighting', zh: '测试正则表达式，内置常用模式和实时高亮' },
    url: '/tools/regex-tester',
    icon: 'M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16 M17 17l4 4 M8 11h6 M11 8v6'
  },
  {
    title: { en: 'Periodic Table of Elements', zh: '化学元素周期表' },
    description: { en: 'Interactive periodic table with Pinyin, tones, pronunciation, and full properties', zh: '交互式化学元素周期表，支持拼音声调、语音朗读、移动端优化与全维度物化属性' },
    url: '/tools/periodic-table',
    icon: 'M12 12h.01 M20 12c0 3-4 5-8 5s-8-2-8-5 4-5 8-5 8 2 8 5 M16 5c3 2 2 6 0 10s-5 6-8 4-2-6 0-10 5-6 8-4'
  }
];
---
<Layout title="Tools / 工具">
<div class="tools-page">
<header class="page-heading">
  <h1>Tools / <span lang="zh">工具</span></h1>
  <p>Useful development and utility tools. / <span lang="zh">实用开发工具集</span></p>
</header>

<h2 class="section-title">Built-in Tools / 内置工具</h2>
<div class="tools-grid">
  {builtInTools.map(tool => (
    <a href={tool.url} class="tool-card surface-card">
      <span class="tool-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={tool.icon} /></svg>
      </span>
      <h3>{tool.title.en}</h3>
      <p class="zh-title">{tool.title.zh}</p>
      <p class="description">{tool.description.en}</p>
    </a>
  ))}
</div>

{tools.length > 0 && (
  <>
    <h2 class="section-title">External Tools / 外部工具</h2>
    <div class="tools-grid">
      {tools.map(tool => (
        <a href={tool.data.url} target="_blank" rel="noopener" class="tool-card surface-card external">
          <h3>{tool.data.title?.en || tool.data.title?.zh}</h3>
          <p class="description">{tool.data.description?.en || tool.data.description?.zh}</p>
          <span class="pricing tag">{tool.data.pricing}</span>
        </a>
      ))}
    </div>
  </>
)}
</div>
</Layout>

<style>
.tools-page {
  padding-block: var(--space-page);
}
.section-title {
  font-size: 1.25rem;
  margin: 2rem 0 1rem;
}
.tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  gap: 1.5rem;
}
.tool-card {
  padding: 1.5rem;
  text-decoration: none;
  color: var(--text);
  display: block;
}
.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  color: var(--primary);
  background: var(--bg-secondary);
  border-radius: var(--radius-control);
  margin-bottom: 1.25rem;
}
.tool-card h3 {
  color: var(--text);
  margin-bottom: 0.25rem;
  font-size: 1.1rem;
}
.tool-card:hover h3 {
  color: var(--primary);
}
.tool-card .zh-title {
  color: var(--text-secondary);
  font-size: 0.95rem;
  margin-bottom: 0.75rem;
}
.tool-card .description {
  color: var(--text-secondary);
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 0;
}
.tool-card.external h3::after {
  content: ' ↗';
  color: var(--text-muted);
  font-size: 0.8em;
}
.pricing {
  margin-top: 1rem;
}
</style>
