---
interface Props {
  defaultLang?: 'en' | 'zh' | 'both';
}
const { defaultLang } = Astro.props;
---
<div class="bilingual-content" data-default-lang={defaultLang}>
  <div class="lang-toggle" role="group" aria-label="Reading language" hidden>
    <button class="lang-btn" type="button" data-lang="en" aria-pressed="false">English</button>
    <button class="lang-btn" type="button" data-lang="zh" aria-pressed="false">中文</button>
    <button class="lang-btn" type="button" data-lang="both" aria-pressed="false">Both</button>
  </div>
  <div class="content-wrapper">
    <slot />
  </div>
</div>

<style>
.bilingual-content { margin: 1.5rem 0; }
.lang-toggle {
  display: flex;
  gap: 0.25rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  padding: 0.3rem;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius-control);
  width: fit-content;
}
.lang-toggle[hidden] { display: none; }
.lang-btn {
  min-height: 44px;
  padding: 0.5rem 1rem;
  border: none;
  background: transparent;
  color: var(--text-secondary);
  border-radius: 5px;
  cursor: pointer;
  transition: background 0.2s, color 0.2s;
  font-size: 0.9rem;
  font-weight: 500;
}
.lang-btn:hover { background: var(--surface); color: var(--text); }
.lang-btn.active { background: var(--button-bg); color: var(--button-text); }
.content-wrapper { display: block; }
.content-wrapper.side-by-side {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 3rem;
}
.content-wrapper > :global(.lang-en),
.content-wrapper > :global(.lang-zh) {
  overflow-x: auto;
  min-width: 0;
}
.content-wrapper.side-by-side > :global(:not(.lang-en):not(.lang-zh)) { grid-column: 1 / -1; }
@media (max-width: 1100px) {
  .content-wrapper.side-by-side { grid-template-columns: 1fr; gap: 2rem; }
  .content-wrapper.side-by-side > :global(.lang-zh) {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
}
</style>

<script>
type ReadingLanguage = 'en' | 'zh' | 'both';
const isReadingLanguage = (value: string | null | undefined): value is ReadingLanguage =>
  value === 'en' || value === 'zh' || value === 'both';

function preferredLanguage(container: HTMLElement): ReadingLanguage {
  let saved: string | null = null;
  try { saved = localStorage.getItem('preferred-lang'); } catch { /* Reading works without browser storage. */ }
  if (isReadingLanguage(saved)) return saved;
  if (isReadingLanguage(container.dataset.defaultLang)) return container.dataset.defaultLang;
  for (const locale of navigator.languages || [navigator.language]) {
    if (/^zh(?:-|$)/i.test(locale)) return 'zh';
    if (/^en(?:-|$)/i.test(locale)) return 'en';
  }
  return 'en';
}

function initializeLanguages() {
  document.querySelectorAll<HTMLElement>('.bilingual-content').forEach(container => {
    const wrapper = container.querySelector<HTMLElement>(':scope > .content-wrapper');
    const toggle = container.querySelector<HTMLElement>(':scope > .lang-toggle');
    if (!wrapper || !toggle) return;
    // A few older posts contain their own BilingualContent component.
    const blocks = [...wrapper.querySelectorAll<HTMLElement>('.lang-en, .lang-zh')]
      .filter(block => block.closest('.bilingual-content') === container);
    const enContent = blocks.filter(block => block.classList.contains('lang-en'));
    const zhContent = blocks.filter(block => block.classList.contains('lang-zh'));
    if (!enContent.length || !zhContent.length) return;

    toggle.hidden = false;
    const buttons = toggle.querySelectorAll<HTMLButtonElement>('.lang-btn');
    function setLanguage(lang: ReadingLanguage, persist = false) {
      container.dataset.lang = lang;
      buttons.forEach(button => {
        const active = button.dataset.lang === lang;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      enContent.forEach(block => { block.style.display = lang === 'zh' ? 'none' : ''; block.lang = 'en'; });
      zhContent.forEach(block => { block.style.display = lang === 'en' ? 'none' : ''; block.lang = 'zh'; });
      wrapper.classList.toggle('side-by-side', lang === 'both');
      if (persist) {
        try { localStorage.setItem('preferred-lang', lang); } catch { /* Preference stays active for this page. */ }
      }
    }
    setLanguage(preferredLanguage(container));
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        if (isReadingLanguage(button.dataset.lang)) setLanguage(button.dataset.lang, true);
      });
    });
  });
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeLanguages);
else initializeLanguages();
</script>
