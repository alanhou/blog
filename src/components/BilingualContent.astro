---
interface Props {
  defaultLang?: 'en' | 'zh' | 'both';
}
const { defaultLang = 'both' } = Astro.props;
---
<div class="bilingual-content" data-lang={defaultLang} data-default-lang={defaultLang}>
  <div class="lang-toggle" role="group" aria-label="Reading language">
    <button class:list={["lang-btn", defaultLang === 'both' && 'active']} type="button" data-lang="both" aria-pressed={defaultLang === 'both' ? 'true' : 'false'}>Both</button>
    <button class:list={["lang-btn", defaultLang === 'en' && 'active']} type="button" data-lang="en" aria-pressed={defaultLang === 'en' ? 'true' : 'false'}>English</button>
    <button class:list={["lang-btn", defaultLang === 'zh' && 'active']} type="button" data-lang="zh" aria-pressed={defaultLang === 'zh' ? 'true' : 'false'}>中文</button>
  </div>
  <div class:list={["content-wrapper", defaultLang === 'both' && 'side-by-side']}>
    <slot />
  </div>
</div>

<style>
.bilingual-content {
  margin: 1.5rem 0;
}
.lang-toggle {
  display: flex;
  gap: 0.25rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  padding: 0.3rem;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--radius-control);
  width: fit-content;
}
.lang-toggle[hidden] {
  display: none;
}
.lang-btn {
  min-height: 40px;
  padding: 0.4rem 1rem;
  border: none;
  background: transparent;
  color: var(--text-secondary);
  border-radius: 5px;
  cursor: pointer;
  transition: background 0.2s, color 0.2s;
  font-size: 0.9rem;
  font-weight: 500;
}
.lang-btn:hover {
  background: var(--surface);
  color: var(--text);
}
.lang-btn.active {
  background: var(--button-bg);
  color: var(--button-text);
}
.content-wrapper {
  display: block;
}
.content-wrapper.side-by-side {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 2.5rem;
}
.content-wrapper > :global(.lang-en),
.content-wrapper > :global(.lang-zh) {
  overflow-x: auto;
  min-width: 0;
}
.content-wrapper.side-by-side > :global(:not(.lang-en):not(.lang-zh)) {
  grid-column: 1 / -1;
}
.content-wrapper.side-by-side > :global(.lang-en),
.content-wrapper.side-by-side > :global(.lang-zh) {
  border-left: 3px solid var(--primary);
  padding-left: 1.25rem;
}
.content-wrapper.side-by-side > :global(.lang-en) {
  border-color: var(--primary);
}
.content-wrapper.side-by-side > :global(.lang-zh) {
  border-color: var(--primary-light, #6bc069);
}
/* Single-language content: span full width in both mode */
.content-wrapper.side-by-side:not(:has(:global(.lang-en))) > :global(.lang-zh),
.content-wrapper.side-by-side:not(:has(:global(.lang-zh))) > :global(.lang-en) {
  grid-column: 1 / -1;
  border-left: none;
  padding-left: 0;
}
@media (max-width: 900px) {
  .content-wrapper.side-by-side {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .content-wrapper.side-by-side > :global(.lang-zh) {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    border-left: none;
    padding-left: 0;
  }
  .content-wrapper.side-by-side > :global(.lang-en) {
    border-left: none;
    padding-left: 0;
  }
}
</style>

<script>
type ReadingLanguage = 'en' | 'zh' | 'both';
const isReadingLanguage = (value: string | null | undefined): value is ReadingLanguage =>
  value === 'en' || value === 'zh' || value === 'both';

function preferredLanguage(container: HTMLElement): ReadingLanguage {
  let saved: string | null = null;
  try { saved = localStorage.getItem('preferred-lang'); } catch { /* Reading works without browser storage. */ }
  if (isReadingLanguage(saved)) return saved;
  if (isReadingLanguage(container.dataset.defaultLang)) return container.dataset.defaultLang;
  return 'both';
}

function initializeLanguages() {
  document.querySelectorAll<HTMLElement>('.bilingual-content').forEach(container => {
    const wrapper = container.querySelector<HTMLElement>(':scope > .content-wrapper');
    const toggle = container.querySelector<HTMLElement>(':scope > .lang-toggle');
    if (!wrapper || !toggle) return;
    // A few older posts contain their own BilingualContent component.
    const blocks = [...wrapper.querySelectorAll<HTMLElement>('.lang-en, .lang-zh')]
      .filter(block => block.closest('.bilingual-content') === container);
    const enContent = blocks.filter(block => block.classList.contains('lang-en'));
    const zhContent = blocks.filter(block => block.classList.contains('lang-zh'));
    
    // Hide toggle for single-language content
    if (!enContent.length || !zhContent.length) {
      toggle.hidden = true;
      wrapper.classList.remove('side-by-side');
      const article = container.closest('.blog-post, .prompt-page');
      if (article) article.classList.remove('is-both');
      return;
    }

    toggle.hidden = false;
    const buttons = toggle.querySelectorAll<HTMLButtonElement>('.lang-btn');
    const article = container.closest('.blog-post, .prompt-page');

    function setLanguage(lang: ReadingLanguage, persist = false) {
      container.dataset.lang = lang;
      if (article) article.classList.toggle('is-both', lang === 'both');
      buttons.forEach(button => {
        const active = button.dataset.lang === lang;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      enContent.forEach(block => { block.style.display = lang === 'zh' ? 'none' : ''; block.lang = 'en'; });
      zhContent.forEach(block => { block.style.display = lang === 'en' ? 'none' : ''; block.lang = 'zh'; });
      wrapper.classList.toggle('side-by-side', lang === 'both');
      if (persist) {
        try { localStorage.setItem('preferred-lang', lang); } catch { /* Preference stays active for this page. */ }
      }
    }

    setLanguage(preferredLanguage(container));
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        if (isReadingLanguage(button.dataset.lang)) setLanguage(button.dataset.lang, true);
      });
    });
  });
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeLanguages);
else initializeLanguages();
</script>
